  ~ Visual Description:
  ~ High-contrast spinal precaution & serious injury pictogram. Shows fallen rider lying flat
  ~ with neutral head/spine alignment, unbroken amber spinal axis, bystander hands stabilizing
  ~ the head, and universal prohibition "DO NOT MOVE" caution symbol.
  -->
<vector xmlns:android="http://schemas.android.com/apk/res/android"
    android:width="280dp"
    android:height="190dp"
    android:viewportWidth="280"
    android:viewportHeight="190">

    <!-- Ground / road baseline -->
    <path
        android:fillColor="#334155"
        android:pathData="M15,165 L265,165 C267,165 268,167 268,169 C268,171 267,173 265,173 L15,173 C13,173 12,171 12,169 C12,167 13,165 15,165 Z" />

    <!-- ── RIDER IN NEUTRAL FLAT POSITION ── -->
    <!-- Rider body / torso (aligned flat) -->
    <path
        android:fillColor="#1E293B"
        android:pathData="M75,155 L180,155 C185,155 190,150 190,145 L190,138 C190,130 180,126 170,126 L80,126 C72,126 68,134 68,144 L68,155 Z" />

    <!-- Rider Legs straight and flat -->
    <path
        android:fillColor="#0F172A"
        android:pathData="M20,156 L76,156 L76,144 L20,144 C17,144 15,147 15,150 C15,153 17,156 20,156 Z" />

    <!-- Rider Helmet / Head (neutral position) -->
    <path
        android:fillColor="#475569"
        android:pathData="M188,148 C188,136 198,126 210,126 C222,126 232,136 232,148 C232,156 225,162 214,162 L198,162 C192,162 188,156 188,148 Z" />

    <!-- Visor -->
    <path
        android:fillColor="#38BDF8"
        android:pathData="M214,132 C220,132 225,136 226,142 C224,145 218,147 212,147 L210,138 C210,134 212,132 214,132 Z" />

    <!-- ── HIGHLIGHTED SPINAL / NECK ALIGNMENT AXIS (Amber #F59E0B) ── -->
    <path
        android:strokeColor="#F59E0B"
        android:strokeWidth="5"
        android:strokeLineCap="round"
        android:pathData="M210,144 L110,144" />
    <path
        android:strokeColor="#FBBF24"
        android:strokeWidth="2"
        android:strokeLineCap="round"
        android:pathData="M210,144 L110,144" />

    <!-- Vertebrae Caution Markers along spine -->
    <path
        android:fillColor="#F59E0B"
        android:pathData="M180,141 L186,141 L186,147 L180,147 Z M150,141 L156,141 L156,147 L150,147 Z M120,141 L126,141 L126,147 L120,147 Z" />

    <!-- ── HEAD STABILIZATION HANDS (C-Spine Protection) ── -->
    <!-- Hands holding head flat and steady on both sides to prevent twisting -->
    <path
        android:fillColor="#F8FAFC"
        android:strokeColor="#64748B"
        android:strokeWidth="1.5"
        android:pathData="M198,116 L222,116 C226,116 228,119 228,123 L228,130 C224,128 214,126 200,126 L198,126 Z" />

    <!-- ── UNIVERSAL CAUTION / PROHIBITION BADGE: "DO NOT MOVE" ── -->
    <!-- Caution Triangle Badge above spine -->
    <path
        android:fillColor="#DC2626"
        android:pathData="M140,25 L166,70 L114,70 Z" />
    <!-- White Exclamation Mark inside Triangle -->
    <path
        android:fillColor="#FFFFFF"
        android:pathData="M138,38 L142,38 L141,56 L139,56 Z M140,61m-2.5,0a2.5,2.5 0,1 1,5 0a2.5,2.5 0,1 1,-5 0" />

    <!-- Universal "DO NOT TWIST / DO NOT MOVE" Prohibited Rotation Arcs -->
    <!-- Prohibited rotation arc 1 around head -->
    <path
        android:strokeColor="#EF4444"
        android:strokeWidth="3.5"
        android:strokeLineCap="round"
        android:pathData="M190,105 C200,95 218,95 228,105" />
    <!-- Red X across rotation arc -->
    <path
        android:strokeColor="#DC2626"
        android:strokeWidth="3.5"
        android:strokeLineCap="round"
        android:pathData="M204,96 L214,106 M214,96 L204,106" />

    <!-- Prohibited rotation arc 2 around torso -->
    <path
        android:strokeColor="#EF4444"
        android:strokeWidth="3"
        android:strokeLineCap="round"
        android:pathData="M130,105 C140,97 155,97 165,105" />
    <!-- Red X across rotation arc 2 -->
    <path
        android:strokeColor="#DC2626"
        android:strokeWidth="3"
        android:strokeLineCap="round"
        android:pathData="M143,98 L151,106 M151,98 L143,106" />

</vector>
