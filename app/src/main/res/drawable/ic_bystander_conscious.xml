    <path
        android:fillColor="#334155"
        android:pathData="M110,165 L115,140 C116,134 122,130 128,130 L145,130 L155,165 Z" />

    <!-- Bystander Torso / Jacket (leaning toward rider's head) -->
    <path
        android:fillColor="#0284C7"
        android:pathData="M130,132 L150,88 C153,82 160,78 168,80 L188,86 C195,88 198,96 195,102 L175,136 Z" />

    <!-- Bystander Head (bent forward listening & looking at rider) -->
    <path
        android:fillColor="#F8FAFC"
        android:pathData="M192,68 C192,57 201,48 212,48 C223,48 232,57 232,68 C232,79 223,88 212,88 C201,88 192,79 192,68 Z" />

    <!-- Bystander Arm & Hand (resting gently on rider's shoulder to check responsiveness) -->
    <path
        android:strokeColor="#0284C7"
        android:strokeWidth="10"
        android:strokeLineCap="round"
        android:strokeLineJoin="round"
        android:pathData="M170,95 L155,115 L145,132" />
    <path
        android:fillColor="#F8FAFC"
        android:pathData="M140,134 C140,129 146,126 151,128 C155,130 156,136 152,139 C148,142 140,139 140,134 Z" />

    <!-- Shoulder touch feedback vibration waves -->
    <path
        android:strokeColor="#38BDF8"
        android:strokeWidth="2.5"
        android:strokeLineCap="round"
        android:pathData="M136,122 C132,126 132,134 136,138" />

    <!-- ── UNIVERSAL VOICE / SPEECH CUE: "CAN YOU HEAR ME?" ── -->
    <!-- Speech bubble pointing from bystander's mouth toward rider's ear -->
    <path
        android:fillColor="#0284C7"
        android:pathData="M210,18 C228,18 244,28 244,42 C244,52 234,60 220,63 L216,73 L208,64 C201,63 196,59 193,54 C198,53 204,49 207,43 C208,35 209,26 210,18 Z" />

