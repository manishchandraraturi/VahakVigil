        android:strokeColor="#38BDF8"
        android:strokeWidth="3.5"
        android:strokeLineCap="round"
        android:pathData="M192,96 C186,104 186,114 192,122" />
    <path
        android:strokeColor="#0284C7"
        android:strokeWidth="3"
        android:strokeLineCap="round"
        android:pathData="M185,99 C178,107 178,118 185,125" />

    <!-- Bold question badge inside / near speech bubble -->
    <path
        android:fillColor="#FFFFFF"
        android:pathData="M226,30 C226,26 222,23 218,23 C213,23 210,26 210,29 L213,29 C213,27 215,25 218,25 C220,25 223,27 223,29 C223,31 221,33 219,34 C217,36 216,38 216,41 L219,41 C219,39 220,38 221,36 C224,34 226,32 226,30 Z M216,45 L220,45 L220,48 L216,48 Z" />

