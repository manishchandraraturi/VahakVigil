  ~ Visual Description:
  ~ High-contrast roadside triage pictogram showing an injured fallen rider lying horizontally
  ~ and a bystander kneeling beside them, placing a hand on the shoulder and speaking directly
  ~ with sound waves and a universal speech question badge ("Can you hear me?").
  -->
<vector xmlns:android="http://schemas.android.com/apk/res/android"
    android:width="280dp"
    android:height="190dp"
    android:viewportWidth="280"
    android:viewportHeight="190">

    <!-- Ground / road baseline -->
    <path
        android:fillColor="#334155"
        android:pathData="M15,165 L265,165 C267,165 268,167 268,169 C268,171 267,173 265,173 L15,173 C13,173 12,171 12,169 C12,167 13,165 15,165 Z" />

    <!-- ── RIDER (Lying on ground facing up/right) ── -->
    <!-- Rider body / jacket -->
    <path
        android:fillColor="#1E293B"
        android:pathData="M60,155 L155,155 C160,155 165,150 165,145 L165,140 C165,135 160,132 150,132 L70,132 C62,132 55,138 55,146 L55,155 Z" />
    
    <!-- Rider legs extending left -->
    <path
        android:fillColor="#0F172A"
        android:pathData="M20,158 L65,158 L65,144 L20,144 C17,144 15,147 15,151 C15,155 17,158 20,158 Z" />

    <!-- Rider Helmet / Head resting flat on ground -->
    <path
        android:fillColor="#475569"
        android:pathData="M165,148 C165,134 176,123 190,123 C204,123 215,134 215,148 C215,157 208,162 195,162 L175,162 C169,162 165,156 165,148 Z" />
    
    <!-- Helmet Visor (sky blue glass reflection) -->
    <path
        android:fillColor="#38BDF8"
        android:pathData="M192,130 C198,130 205,134 207,142 C205,145 198,148 190,148 L188,136 C188,132 190,130 192,130 Z" />

